//@version=6
// ORB — Opening Range Breakout. The strategy from research/orb.py, same rules.
//
// Measured on 7,063 trades over 7.8 years of 5m NQ (see backtests/2026-10-09_ORB_nq_5m.md):
//   win rate 65.4%, +0.022R per trade, null test p = 0.00, positive in 6 of 8 years.
//
// Rules:
//   - opening range = high/low of the first N minutes after the session open
//   - enter on the first close beyond the range, LONG ONLY by default
//     (shorts measured negative at every window tested: -0.023R to -0.043R)
//   - stop at the opposite side of the range; target = 0.5 x the stop distance
//   - one trade per day per window; flat by the close
//
// To reproduce the research stack, run five copies with Range = 10/20/30/45/60.
strategy("ORB | Opening Range Breakout",
     overlay                 = true,
     initial_capital         = 50000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.62,
     slippage                = 1,
     process_orders_on_close = false,
     calc_on_every_tick      = false)

// ── INPUTS ──────────────────────────────────────────────────
rangeMin   = input.int(60,   'Opening range (minutes)', minval = 5, maxval = 240, step = 5, group = 'Setup')
rr         = input.float(0.5,'Target as a fraction of the stop', minval = 0.1, maxval = 5.0, step = 0.1, group = 'Setup')
dirMode    = input.string('Long only', 'Direction', options = ['Long only', 'Short only', 'Both'], group = 'Setup')
sessStart  = input.int(930,  'Session open (NY HHmm)', group = 'Session')
flatHHmm   = input.int(1550, 'Flatten at (NY HHmm)',   group = 'Session')
riskPct    = input.float(0.75,'Risk per trade (%)', minval = 0.05, step = 0.05, group = 'Risk')
maxQty     = input.int(20,   'Max contracts', minval = 1, group = 'Risk')
minRangePts= input.float(5,  'Skip if range is narrower than (points)', minval = 0, group = 'Risk')

const string NY = 'America/New_York'

// ── CLOCK ───────────────────────────────────────────────────
nyHHmm   = hour(time_close, NY) * 100 + minute(time_close, NY)
newDay   = dayofmonth(time_close, NY) != dayofmonth(time_close[1], NY)
rangeEnd = sessStart + (rangeMin / 60) * 100 + (rangeMin % 60)
inRange  = nyHHmm > sessStart and nyHHmm <= rangeEnd
afterRange = nyHHmm > rangeEnd and nyHHmm < flatHHmm

// ── BUILD THE OPENING RANGE ─────────────────────────────────
var float orHigh = na
var float orLow  = na
var bool  tradedToday = false

if newDay
    orHigh := na
    orLow  := na
    tradedToday := false

if inRange
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow,  low)

rangeReady = afterRange and not na(orHigh) and not na(orLow) and (orHigh - orLow) >= minRangePts

// ── ENTRY ───────────────────────────────────────────────────
// Signal on the CLOSE of a bar beyond the range; Pine fills at the next bar's open,
// which matches the research code exactly.
breakUp   = rangeReady and close > orHigh
breakDown = rangeReady and close < orLow

allowLong  = dirMode == 'Long only'  or dirMode == 'Both'
allowShort = dirMode == 'Short only' or dirMode == 'Both'

longSig  = breakUp   and allowLong  and not tradedToday and strategy.position_size == 0
shortSig = breakDown and allowShort and not tradedToday and strategy.position_size == 0

// Size from the stop distance: the stop is the opposite side of the range
stopDistLong  = rangeReady ? close - orLow  : na
stopDistShort = rangeReady ? orHigh - close : na

qtyFor(float stopDist) =>
    riskCash = strategy.equity * riskPct / 100
    perCtr   = stopDist * syminfo.pointvalue
    perCtr > 0 ? math.min(maxQty, math.floor(riskCash / perCtr)) : 0

if longSig
    q = qtyFor(stopDistLong)
    if q >= 1
        tradedToday := true
        strategy.entry('ORB L', strategy.long, qty = q)
        strategy.exit('ORB L x', 'ORB L', stop = orLow, limit = close + stopDistLong * rr)

if shortSig
    q = qtyFor(stopDistShort)
    if q >= 1
        tradedToday := true
        strategy.entry('ORB S', strategy.short, qty = q)
        strategy.exit('ORB S x', 'ORB S', stop = orHigh, limit = close - stopDistShort * rr)

// ── FLATTEN ─────────────────────────────────────────────────
if strategy.position_size != 0 and nyHHmm >= flatHHmm
    strategy.close_all(comment = 'EOD')

// ── PLOTS ───────────────────────────────────────────────────
plot(rangeReady or inRange ? orHigh : na, 'Range high', color = color.new(color.teal, 20), style = plot.style_linebr, linewidth = 2)
plot(rangeReady or inRange ? orLow  : na, 'Range low',  color = color.new(color.orange, 20), style = plot.style_linebr, linewidth = 2)
bgcolor(inRange ? color.new(color.blue, 90) : na, title = 'Opening range window')
plotshape(longSig,  'Long break',  shape.triangleup,   location.belowbar, color.new(color.teal, 10),   size = size.small)
plotshape(shortSig, 'Short break', shape.triangledown, location.abovebar, color.new(color.orange, 10), size = size.small)
