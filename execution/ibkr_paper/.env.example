# Copy to .env and edit. Only paper ports are accepted: 7497 (TWS) or 4002 (IB Gateway).
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17

SYMBOL=MNQ
EXCHANGE=CME
BAR_MINUTES=5
ROLL_DAYS=8

SEQ_LEN=3
MIN_BODY_ATR=0.1
ATR_LEN=14
ATR_SL=1.7
ATR_TP=2.5

RISK_PCT=0.01
MAX_CONTRACTS=5
MAX_DAILY_LOSS=1000
MAX_TRADES_PER_DAY=4

# New York time
SESSION_START=09:30
SESSION_END=11:30
FLATTEN_AT=15:50

# local = bot computes CBE itself (free). webhook = take TradingView alerts (needs paid TV plan + public URL).
SIGNAL_SOURCE=local
WEBHOOK_SECRET=
